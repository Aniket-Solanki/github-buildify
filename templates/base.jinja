<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <meta name="theme-color" content="#059669"/>
    <meta name="apple-mobile-web-app-capable" content="yes"/>
    <meta name="apple-mobile-web-app-status-bar-style" content="default"/>
    <meta name="mobile-web-app-capable" content="yes">
    <title>{% block title %}My Resume Generator – Turn GitHub into Your Resume{% endblock %}</title>

    <meta name="description"
          content="Automatically generate a professional, ATS-friendly resume from your GitHub repository. Highlight your tech stack and achievements powered by AI."/>
    <meta name="keywords" content="Resume generator, GitHub to Resume, AI resume, ATS resume, Developer portfolio"/>
    <meta name="author" content="Me"/>

    <link rel="canonical" href="{{ request.url }}"/>

    {% include 'partials/favicons.jinja' %}

    {% block og_meta %}
        <meta property="og:type" content="website"/>
        <meta property="og:url" content="{{ request.url }}"/>
        <meta property="og:title" content="My Resume Generator – Turn GitHub into Your Resume"/>
        <meta property="og:description"
              content="Automatically generate a professional, ATS-friendly resume from your GitHub repository. Highlight your tech stack and achievements powered by AI."/>
        <meta property="og:image" content="{{ url_for('static', path='android-chrome-512x512.png') }}"/>
    {% endblock %}

    {% block twitter_meta %}
        <meta property="twitter:card" content="summary_large_image"/>
        <meta property="twitter:url" content="{{ request.url }}"/>
        <meta name="twitter:title" content="My Resume Generator – Turn GitHub into Your Resume"/>
        <meta name="twitter:description"
              content="Transform your GitHub repositories into a powerful AI-enhanced resume with deep project insights and achievements."/>
        <meta name="twitter:image"
              content="{{ url_for('static', path='android-chrome-512x512.png') }}"/>    {% endblock %}
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/roughjs@latest/bundled/rough.js"></script>
    <!-- 100% privacy-first analytics -->
    <script data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" alt="" referrerpolicy="no-referrer-when-downgrade"/></noscript>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    screens: {
                        'xs': '375px',
                        '3xl': '1600px',
                    },
                    spacing: {
                        'safe-top': 'env(safe-area-inset-top)',
                        'safe-bottom': 'env(safe-area-inset-bottom)',
                        'safe-left': 'env(safe-area-inset-left)',
                        'safe-right': 'env(safe-area-inset-right)',
                    }
                }
            }
        }
    </script>

    {% block extra_head %}{% endblock %}

    {% include 'partials/styles.jinja' %}
</head>

<body class="bg-[#F8FFF8] {% block body_class %}flex flex-col min-h-screen{% endblock %} font-sans antialiased relative">
{% include 'partials/background-doodles.jinja' %}
{% include 'partials/header.jinja' %}

{% block content %}{% endblock %}

{% include 'partials/footer.jinja' %}

{% block scripts %}{% endblock %}
</body>
</html>